    project_file_versions {
        bigint id PK
        bigint project_file_id FK
        bigint user_id FK "nullable"
        smallint number
        varchar path
        varchar original_name
        varchar mime_type "nullable"
        bigint size
        varchar note "nullable"
        timestamp created_at
    }
    project_files {
        bigint id PK
        bigint project_id FK
        bigint user_id FK "nullable"
        varchar name
        smallint versions_count
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    project_invitations {
        bigint id PK
        bigint project_id FK
        bigint invited_by FK "nullable"
        varchar email
        varchar role
        varchar token_hash UK
        varchar status
        timestamp expires_at
        timestamp responded_at "nullable"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    project_members {
        bigint id PK
        bigint project_id FK
        bigint user_id FK
        varchar role
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    project_tasks {
        bigint id PK
        bigint project_id FK
        bigint created_by FK "nullable"
        bigint assignee_id FK "nullable"
        varchar title
        text description "nullable"
        varchar status
        varchar priority
        date due_on "nullable"
        timestamp completed_at "nullable"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    project_thread_replies {
        bigint id PK
        bigint project_thread_id FK
        bigint user_id FK "nullable"
        text body
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    project_threads {
        bigint id PK
        bigint project_id FK
        bigint user_id FK "nullable"
        bigint project_file_id FK "nullable"
        varchar title
        text body
        varchar status
        bigint resolved_by FK "nullable"
        timestamp resolved_at "nullable"
        int replies_count
        timestamp last_activity_at "nullable"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    projects {
        bigint id PK
        bigint user_id FK
        varchar name
        varchar slug UK
        text description "nullable"
        varchar visibility
        varchar status
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
