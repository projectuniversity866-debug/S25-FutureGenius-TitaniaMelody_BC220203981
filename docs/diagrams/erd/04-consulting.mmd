    availability_exceptions {
        bigint id PK
        bigint consultant_profile_id FK
        date date
        varchar reason "nullable"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    availability_rules {
        bigint id PK
        bigint consultant_profile_id FK
        tinyint weekday
        varchar starts
        varchar ends
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    consultant_profiles {
        bigint id PK
        bigint user_id FK, UK
        varchar slug UK
        varchar headline
        text bio "nullable"
        json expertise "nullable"
        smallint session_minutes
        int price_pkr "nullable"
        varchar timezone
        smallint notice_hours
        smallint window_days
        tinyint is_accepting
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    consultations {
        bigint id PK
        bigint consultant_profile_id FK
        bigint client_id FK "nullable"
        bigint consulting_client_id FK "nullable"
        timestamp starts_at
        timestamp ends_at
        varchar topic
        text message "nullable"
        varchar meeting_url "nullable"
        varchar status
        varchar slot_key UK "nullable"
        bigint cancelled_by FK "nullable"
        varchar cancel_reason "nullable"
        timestamp cancelled_at "nullable"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    consulting_client_notes {
        bigint id PK
        bigint consulting_client_id FK
        text body
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    consulting_clients {
        bigint id PK
        bigint consultant_profile_id FK
        bigint user_id FK "nullable"
        varchar name
        varchar email "nullable"
        varchar phone "nullable"
        varchar organization "nullable"
        varchar status
        varchar source
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
