erDiagram
    consultant_profiles ||--o{ availability_exceptions : "consultant_profile_id"
    consultant_profiles ||--o{ availability_rules : "consultant_profile_id"
    users ||--o| consultant_profiles : "user_id"
    users |o--o{ consultations : "cancelled_by"
    users |o--o{ consultations : "client_id"
    consultant_profiles ||--o{ consultations : "consultant_profile_id"
    consulting_clients |o--o{ consultations : "consulting_client_id"
    consulting_clients ||--o{ consulting_client_notes : "consulting_client_id"
